{
  "name": "taiwan-exchange-rates",
  "version": "0.1.0",
  "description": "Taiwanese bank exchange-rate library and CLI",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/taiwan-exchange-rates.git"
  },
  "bin": {
    "twrate": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "check": "biome ci .",
    "test": "vitest run",
    "ci": "npm run check && npm test && npm run build",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "impit": "^0.14.5"
  }
}
